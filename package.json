{
	"schema": 1,
	"source": "addon",
	"output": "dist",
	"actions": [
		["firefox", ["firefox"]],
		["chrome", ["chrome"]],
		["all", ["firefox", "chrome"]]
	],
	"common": [
		"icons",
		"_locales",
		"options",
		"sounds"
	],
	"targets": {
		"firefox": {
			"output": "firefox",
			"manifest": "manifest.firefox.json",
			"bundle": "extra-sounds-firefox.zip",
			"files": [
				"scripts/background.js"
			]
		},
		"chrome": {
			"output": "chrome",
			"manifest": "manifest.chrome.json",
			"bundle": "extra-sounds-chrome.zip",
			"files": [
				"scripts/background.js"
			]
		}
	}
}
